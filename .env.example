# Copy this file to `.env` and fill in the values only if you need to run the
# cross-browser (SauceLabs / BrowserStack) test suites. None of these variables
# are required for local development or for the local-only test run
# (`npm run test:local`), which uses a headless local Chrome.

# Which remote browser provider to use in CI: "saucelabs" or "browserstack".
# Leave unset for local runs.
# BROWSER_PROVIDER=

# SauceLabs credentials (only needed for `JOB=unit` / `JOB=e2e` on Travis with
# BROWSER_PROVIDER=saucelabs).
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=

# BrowserStack credentials (only needed for `JOB=unit` with
# BROWSER_PROVIDER=browserstack).
# BROWSER_STACK_USERNAME=
# BROWSER_STACK_ACCESS_KEY=