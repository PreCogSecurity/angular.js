# Environment variables used by the build, the test runners and CI.
#
# Copy this file to `.env` and fill in values ONLY if you need to run the
# cross-browser (SauceLabs / BrowserStack) test suites:
#
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed: it holds live credentials.
# CI never reads this file - Travis injects the same variables from the
# repository secret store (Settings -> Environment Variables), which is the only
# place a real access key belongs. `npm run security:check` fails the build if a
# local `.env` or an inlined credential is ever committed by accident.
#
# None of these variables are required for local development, for
# `grunt package`, for the lint gates (`npm run lint`), or for the local-only
# test run (`npm run test:local`), which uses a headless local Chrome.
#
# ---------------------------------------------------------------------------
# Remote browser provider (cross-browser CI only)
# ---------------------------------------------------------------------------

# Which remote browser provider to use in CI: "saucelabs" or "browserstack".
# Leave unset for local runs.
# BROWSER_PROVIDER=

# Absolute path the browser-provider tunnel writes its readiness marker to.
# Consumed by scripts/travis/start_browser_provider.sh.
# BROWSER_PROVIDER_READY_FILE=/tmp/browsersprovider-tunnel-ready

# Set to 1 by scripts/travis/build.sh when the e2e matrix job must run against
# jQuery instead of jqLite.
# USE_JQUERY=

# ---------------------------------------------------------------------------
# SauceLabs credentials
# Optional. Only needed for `JOB=unit` / `JOB=e2e` / `JOB=docs-e2e` on Travis
# with BROWSER_PROVIDER=saucelabs. Not needed for `npm run test:local`.
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=

# ---------------------------------------------------------------------------
# BrowserStack credentials
# Optional. Only needed for `JOB=unit` on Travis with
# BROWSER_PROVIDER=browserstack. Not needed for `npm run test:local`.
# Note: scripts/travis/build.sh reverses BROWSER_STACK_ACCESS_KEY before
# handing it to the tunnel wrapper, so the value stored in the secret store is
# the reverse of the one shown in the BrowserStack dashboard.
# BROWSER_STACK_USERNAME=
# BROWSER_STACK_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Build metadata (CI only; all optional)
# ---------------------------------------------------------------------------

# Provided automatically by Travis. Recorded in the JUnit report names so that
# results from concurrent matrix jobs can be told apart.
# TRAVIS=
# TRAVIS_BUILD_ID=
# TRAVIS_BUILD_NUMBER=
# TRAVIS_JOB_NUMBER=

# Numeric build number. Falls back to TRAVIS_BUILD_NUMBER when unset.
# BUILD_NUMBER=

# Directory the build writes logs and test reports to. Created by
# scripts/travis/before_build.sh.
# LOGS_DIR=/tmp/angular-build/logs
